htfA = input.timeframe("15", "HTF 1 (fast confirmation)", group = grpPro)
htfB = input.timeframe("60", "HTF 2 (primary bias)", group = grpPro)
htfC = input.timeframe("1D", "HTF 3 (primary bias)", group = grpPro)
