// ── Scalping engine ─────────────────────────────────────────────────────────
// Model: higher-timeframe bias (HTF 2 + HTF 3, i.e. 1H + 1D by default) decides
// direction; the chart timeframe is only used to time a pullback entry inside
// that bias. This is the trend-pullback continuation template, which is what
// survives on 1-15m charts. Momentum chasing is filtered out on purpose.
grpScalp = "Scalping Engine (1m-15m)"
scalpMode = input.bool(true, "Scalp mode", group = grpScalp,
     tooltip = "Allows Must/Important patterns on 1-15m charts and enables the scalp filters, targets and stops below.")
scalpTfList = input.string("1,2,3,5,15", "Scalp chart timeframes", group = grpScalp)
fastLen = input.int(9, "Fast EMA (entry trigger)", group = grpScalp, minval = 2)
midLen = input.int(21, "Mid EMA (pullback band)", group = grpScalp, minval = 3)
requireBothHTF = input.bool(true, "Require BOTH bias timeframes to agree",
     group = grpScalp,
     tooltip = "ON: HTF 2 and HTF 3 (1H and 1D) must both point the same way before a strong signal is allowed.")
maxExtATR = input.float(1.5, "Reject entries further than (x ATR) from fast EMA",
     group = grpScalp, minval = 0.25, step = 0.25,
     tooltip = "The single most common scalping loss: entering after the move already ran. This rejects extended candles.")
maxRsiChase = input.float(78.0, "Do not buy above RSI (mirrored for sells)",
     group = grpScalp, minval = 55.0, maxval = 95.0, step = 1.0)
useSession = input.bool(true, "Only signal inside killzones", group = grpScalp,
     tooltip = "Spot FX scalping outside the London and New York sessions pays spread into thin liquidity.")
sessA = input.session("0700-1000", "Killzone 1 (London)", group = grpScalp)
sessB = input.session("1200-1500", "Killzone 2 (New York)", group = grpScalp)
sessTz = input.string("GMT", "Killzone timezone", group = grpScalp,
     options = ["GMT", "GMT-5", "GMT-4", "GMT+1", "GMT+2", "GMT+7", "GMT+8", "America/New_York", "Europe/London", "Asia/Tokyo"])
scalpSLMult = input.float(0.8, "Scalp ATR stop floor", group = grpScalp,
     minval = 0.3, step = 0.1)
scalpRR1 = input.float(1.0, "Scalp TP1 R multiple", group = grpScalp,
     minval = 0.5, step = 0.25)
scalpRR2 = input.float(2.0, "Scalp TP2 R multiple", group = grpScalp,
     minval = 0.5, step = 0.25)
minTargetPips = input.float(3.0, "Minimum TP1 distance (pips)", group = grpScalp,
     minval = 0.0, step = 0.5,
     tooltip = "Rejects setups whose first target is too small to clear the spread. Set to your pair's typical spread x 3.")
maxHoldBars = input.int(30, "Maximum hold (bars) - time stop", group = grpScalp,
     minval = 1, maxval = 200,
     tooltip = "Your stated hold is 1-30 minutes. On a 1m chart 30 bars = 30 minutes. Also sets how far the SL/TP lines extend.")
signalCooldown = input.int(5, "Minimum bars between signals", group = grpScalp,
     minval = 0)
sbsMin = input.int(78, "Strong signal minimum score", group = grpScalp,
     minval = 50, maxval = 100)
showSignals = input.bool(true, "Show SBS / SSS signals", group = grpScalp)
showSignalArrows = input.bool(true, "Show signal arrows", group = grpScalp)
showSignalLevels = input.bool(true, "Draw SL / TP1 / TP2 lines", group = grpScalp)
maxSignalDraws = input.int(4, "Signal level sets kept on chart",
     group = grpScalp, minval = 1, maxval = 12)

// ── Account & position size ─────────────────────────────────────────────────
// A small account is the binding constraint, not the signal quality. These
// inputs turn every signal's stop distance into an actual lot size and an
// actual dollar risk, and warn when the broker minimum forces more risk than
// intended.
grpRisk = "Account & Position Size"
acctSize = input.float(50.0, "Account size ($)", group = grpRisk,
     minval = 1.0, step = 10.0)
riskPct = input.float(2.0, "Risk per trade (%)", group = grpRisk,
     minval = 0.1, maxval = 10.0, step = 0.1,
     tooltip = "Percent of the account risked if the stop is hit. 1-2% is the standard. On a very small account the broker's minimum lot may exceed this - the panel tells you when that happens.")
contractSize = input.float(100000.0, "Units per 1.00 lot", group = grpRisk,
     minval = 1.0,
     tooltip = "100000 for a standard FX lot. Set to 1 for most CFDs and crypto.")
minLot = input.float(0.01, "Broker minimum lot", group = grpRisk,
     minval = 0.0001, step = 0.01)
lotStep = input.float(0.01, "Lot step", group = grpRisk,
     minval = 0.0001, step = 0.01)

// ── Fibonacci engine ────────────────────────────────────────────────────────
// Retracement of the last confirmed swing leg. Used as a location filter:
// longs are preferred in discount (below the 50% of an up leg), shorts in
// premium, and the 0.618-0.705 "golden pocket" is the premium entry area.
grpFib = "Fibonacci Engine"
useFib = input.bool(true, "Check: Fibonacci discount / premium", group = grpFib)
showFib = input.bool(true, "Draw Fibonacci levels", group = grpFib)
fibGoldenLo = input.float(0.618, "Golden pocket start", group = grpFib,
     minval = 0.3, maxval = 0.9, step = 0.001)
fibGoldenHi = input.float(0.705, "Golden pocket end", group = grpFib,
     minval = 0.3, maxval = 0.95, step = 0.001)
cFib = input.color(#B39DDB, "Fibonacci level colour", group = grpFib)
cFibGold = input.color(#FFC107, "Golden pocket colour", group = grpFib)

// ── Colours & legend ────────────────────────────────────────────────────────
grpCol = "Colours & Legend"
sigTablePos = input.string("Middle right", "Signal detail table position",
     group = grpCol,
     options = ["Middle right", "Top right", "Bottom right", "Middle left",
     "Bottom left", "Off"],
     tooltip = "Shows the most recent SBS/SSS breakdown as a table, so you do not have to hover the label.")
boundBosLines = input.bool(true, "Keep BOS / CHoCH lines short", group = grpCol,
     tooltip = "ON draws the break line only across the swing it broke. OFF extends it to the right edge, which gets messy quickly.")
bosLinePad = input.int(6, "BOS / CHoCH line extension (bars)", group = grpCol,
     minval = 0, maxval = 100)
showLegend = input.bool(true, "Show colour legend", group = grpCol)
showScalpMAs = input.bool(true, "Plot fast / mid / slow EMAs", group = grpCol)
showVwapLine = input.bool(true, "Plot VWAP", group = grpCol)
cEmaF = input.color(#FFD600, "Fast EMA (9)", group = grpCol)
cEmaM = input.color(#E040FB, "Mid EMA (21)", group = grpCol)
cEmaS = input.color(#90A4AE, "Slow EMA (50)", group = grpCol)
cVwap = input.color(#00E5FF, "VWAP", group = grpCol)
cBBBand = input.color(#2962FF, "Bollinger upper / lower", group = grpCol)
